# Normalise line endings so the repo is usable from Windows and Linux alike.
* text=auto eol=lf

# The vendored upstream preload tree must stay byte-identical to what was extracted from the shipped
# app.asar, so no line-ending conversion may be applied to it.
vendor/vacuumtube-preload/** -text

# The build scripts are Windows/PowerShell first.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary assets must never be touched.
*.png binary
*.ico binary
*.jar binary
*.apk binary
*.keystore binary
*.idsig binary
